# Copy to .env and fill in for this machine. .env is gitignored.

# GEMINI_API_KEY=

# DOCX -> PDF without Microsoft Word
# OnlyOffice converter (macOS: brew install --cask onlyoffice; open the app once so it builds its font list)
#   macOS:   /Applications/ONLYOFFICE.app/Contents/Resources/converter/x2t
#   Windows: C:\Program Files\ONLYOFFICE\DesktopEditors\converter\x2t.exe
LESSON_BUILDER_X2T=
# Folder with AllFonts.js and font_selection.bin, written by the OnlyOffice app on launch
#   macOS:   ~/Library/Application Support/asc.onlyoffice.ONLYOFFICE/data/fonts
#   Windows: %LOCALAPPDATA%\ONLYOFFICE\DesktopEditors\data\fonts
LESSON_BUILDER_ONLYOFFICE_FONTS=
# LibreOffice fallback
#   macOS:   /opt/homebrew/bin/soffice
#   Windows: C:\Program Files\LibreOffice\program\soffice.exe
LESSON_BUILDER_SOFFICE=
# Force one engine: word | onlyoffice | libreoffice (unset = Word, then OnlyOffice, then LibreOffice)
# LESSON_BUILDER_PDF_ENGINE=
